# Production secrets template.
# Copy to .env.production and fill in real values — .env.production is gitignored.
# In CI/CD: inject these as environment variables instead of using this file.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=commerce
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_ISSUER=CommerceSphere
JWT_AUDIENCE=CommerceSphereClients
JWT_EXPIRY_MINUTES=60

# ── Social login (OAuth) ──────────────────────────────────────────────────────
# Leave a provider's pair blank to keep it disabled. Register your production callback
# URL (https://your-domain.com/api/auth/sso/callback) in each provider's developer console.
#   Google   → https://console.cloud.google.com  (APIs & Services → Credentials)
#   Facebook → https://developers.facebook.com  (App → Facebook Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Cloudinary (image upload) ─────────────────────────────────────────────────
# From your Cloudinary dashboard. Leave blank to disable upload (paste-URL still works).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
