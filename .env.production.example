# Production secrets template.
# Copy to .env.production and fill in real values — .env.production is gitignored.
# In CI/CD: inject these as environment variables instead of using this file.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=commerce
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_ISSUER=CommerceSphere
JWT_AUDIENCE=CommerceSphereClients
JWT_EXPIRY_MINUTES=60

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Get from Keycloak admin console → Clients → commerce-sphere-client → Credentials
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE
