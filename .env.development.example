# Development environment template.
# Copy this to .env.development and fill in any local secrets (e.g. OAuth credentials):
#     cp .env.development.example .env.development
# .env.development is gitignored so real secrets never get committed. Docker Compose reads it via
# the `.env` symlink (for ${VAR} substitution) and `env_file:` in docker-compose.override.yml.
# The Postgres/JWT values below are throwaway local defaults — safe to keep as-is for dev.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce_pass

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CommerceSphere_SuperSecret_JWT_Key_2024_Min32Chars!!
JWT_ISSUER=CommerceSphere
JWT_AUDIENCE=CommerceSphereClients
JWT_EXPIRY_MINUTES=60

# ── Social login (OAuth) ──────────────────────────────────────────────────────
# Leave blank to keep a provider disabled (it simply won't appear on the login page).
# Fill in real credentials from each provider's developer console to enable it locally:
#   Google   → https://console.cloud.google.com  (APIs & Services → Credentials)
#   Facebook → https://developers.facebook.com  (App → Facebook Login)
# Authorized redirect URI to register in each console: http://localhost:5000/api/auth/sso/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Cloudinary (image upload) ─────────────────────────────────────────────────
# Product/banner image uploads go to Cloudinary. Get these from your Cloudinary dashboard
# (https://cloudinary.com → Dashboard). Leave blank to disable upload (paste-URL still works).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
