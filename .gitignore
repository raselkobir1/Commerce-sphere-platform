# ── VS Code ───────────────────────────────────────────────────────────────────
# Ignore .vscode CONTENTS (use /* not / — a trailing-slash dir exclude can't be undone by !negations
# below, since git won't re-include a file whose parent directory is excluded).
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
# Shared workspace settings (hides bin/obj in the Explorer, search excludes) — intentionally tracked.
!.vscode/settings.json
# Nested (per-app) .vscode dirs stay local — only the root workspace settings are shared.
frontend/.vscode/

# ── Visual Studio ─────────────────────────────────────────────────────────────
.vs/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.opendb
ipch/
*.psess
*.vsp
*.vspx
*.sap
*.e2e
BenchmarkDotNet.Artifacts/

# ── Secrets and environment ───────────────────────────────────────────────────
# NOTE: .gitignore does NOT support inline "# comments" after a pattern — the text
# becomes part of the pattern and the rule silently matches nothing. Keep each
# pattern on its own line with comments above.
#
# .env is a tracked symlink -> .env.development (Compose only auto-loads a file named
# exactly ".env" for ${VAR} substitution; env_file: entries don't cover that). It is
# intentionally NOT ignored.
#
# local dev secrets (real OAuth creds, etc.) — copy .env.development.example to set up
.env.development
# real production secrets
.env.production
.env.local
appsettings.Local.json
appsettings.local.json
appsettings.*.local.json
secrets.json
**/secrets/

# ── Docker compose ────────────────────────────────────────────────────────────
# docker-compose.override.yml  ← committed (team-wide dev settings, auto-loaded)
# docker-compose.prod.yml      ← committed (production deployment config)
# docker-compose.local.yml     ← NOT committed (per-machine personal overrides)
docker-compose.local.yml

# ── HTTPS dev certificates ────────────────────────────────────────────────────
*.pfx
*.pem
*.cer
*.p12
!**/test-assets/*.pfx

