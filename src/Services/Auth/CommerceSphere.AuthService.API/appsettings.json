{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "AuthDb": "Host=postgres-auth;Port=5432;Database=auth_db;Username=commerce;Password=commerce_pass;",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Secret": "CommerceSphere_SuperSecret_JWT_Key_2024_Min32Chars!!",
    "Issuer": "CommerceSphere",
    "Audience": "CommerceSphereClients",
    "ExpiryMinutes": "60"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092"
  },
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/commerce-sphere",
    "ClientId": "commerce-sphere-client",
    "ClientSecret": "",
    "CallbackBaseUrl": "http://localhost:5000",
    "CallbackPath": "/api/auth/sso/callback"
  },
  "AllowedHosts": "*"
}
